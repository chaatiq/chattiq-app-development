# Copy to .env and fill in.

PORT=5002

# Same PostgreSQL database as the Chattiq API (users, chats).
# On Windows use 127.0.0.1 instead of localhost (localhost is much slower there).
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/chatiq

# Must be the SAME value as JWT_SECRET of the Chattiq API, so access tokens
# issued here are accepted by the Chattiq API and the other way round.
JWT_SECRET=replace-with-the-chattiq-jwt-secret

# Chattiq API, ending in /api. Login and every request this service does not
# handle itself (chats, messages, takeover...) are forwarded here.
CHATTIQ_API_URL=http://127.0.0.1:5001/api

# Shared secret for POST /api/internal/notify-message, called by the Chattiq
# AI runtime when a customer sends a message. Must equal INTERNAL_API_KEY of the
# AI runtime (it sends that key in the x-internal-api-key header).
NOTIFY_API_KEY=replace-with-long-random-key

# Firebase service account key (JSON) for sending notifications through FCM.
# Keep the file OUTSIDE the repository and never commit it.
FIREBASE_SERVICE_ACCOUNT_FILE=C:/path/to/firebase-adminsdk.json
